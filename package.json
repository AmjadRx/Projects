{
  "name": "amjad-rehawi-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "next dev",
    "prebuild": "npm run check:lockfile && node scripts/copy-vendor.mjs && node scripts/content-dates.mjs && npm run check:content && npm run check:sky",
    "build": "next build",
    "postbuild": "npm run check:sky -- --build && npm run check:secrets -- --build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:build": "vitest run --config vitest.build.config.mts",
    "check:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content.mjs",
    "migrate:v2-to-v3": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate-v2-to-v3.mjs",
    "samples": "node scripts/make-samples.mjs",
    "build:sky": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-sky.mjs",
    "render:stills": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-stills.mjs",
    "check:sky": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-sky.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "prepare": "simple-git-hooks",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:lockfile": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-lockfile.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check:content && npm run check:lockfile"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@jsquash/webp": "1.5.0",
    "@mediabunny/aac-encoder": "1.66.0",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.9.0",
    "@vercel/functions": "3.11.3",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.18",
    "file-type": "22.3.0",
    "image-size": "2.1.0",
    "jsdom": "31.0.1",
    "jszip": "3.10.2",
    "libheif-js": "1.23.5",
    "lucide-react": "^0.454.0",
    "mediabunny": "1.66.0",
    "meshoptimizer": "1.3.0",
    "motion": "14.14.0",
    "next": "14.2.15",
    "occt-import-js": "0.0.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-pdf": "10.5.0",
    "server-only": "0.0.1",
    "shiki": "4.6.0",
    "three": "^0.169.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
