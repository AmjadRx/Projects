# Names of every variable the site and the admin read. No values here, ever.
# Set real values in Vercel (Settings > Environment Variables) and, for local work, in .env.local,
# which git ignores. docs/ADMIN_GUIDE.md explains each one.

# The admin. Without both, /admin shows a setup notice and every admin route answers 503.
ADMIN_PASSWORD=
# At least 32 random characters. Changing it (or ADMIN_PASSWORD) signs everyone out.
SESSION_SECRET=

# GitHub: a fine-grained token for this repository only, with Contents read and write
# (and Deployments read, for the deploy state in the status panel).
GITHUB_TOKEN=
# owner/name of this repository.
GITHUB_REPO=
# The published branch that Publish fast-forwards: main in Production, sandbox-main in Preview.
GITHUB_BRANCH=
# The branch every save commits to: draft in Production, sandbox-draft in Preview. Never main.
GITHUB_DRAFT_BRANCH=

# Private terms the content check refuses, separated by a vertical bar. Saves and builds on
# Vercel fail closed without it.
CONTENT_BLOCKLIST=

# Vercel Blob, for files over 4 MB. Connecting a Blob store to an environment sets it.
BLOB_READ_WRITE_TOKEN=
# Optional: the store's public host (<id>.public.blob.vercel-storage.com). Worked out from the
# token when unset.
BLOB_STORE_HOST=

# Optional: deploy state from the Vercel API instead of GitHub's deployment records.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Optional: the draft branch's preview address, when it cannot be worked out.
DRAFT_PREVIEW_URL=

# Motion+ (private npm registry), for the Phase 5 motion pieces.
MOTION_TOKEN=

# Optional: the production address used in metadata and the content check.
NEXT_PUBLIC_SITE_URL=
